# Salin file ini menjadi .env.local lalu isi nilainya (JANGAN simpan .env.local di GitHub).
# Nilainya ada di Supabase: Project Settings -> API Keys / Data API.

# Alamat proyek, contoh: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Kunci publik (Publishable key, diawali sb_publishable_). Boleh terlihat di browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Kunci RAHASIA (Secret key, diawali sb_secret_). Hanya untuk server. Jangan dibagikan.
SUPABASE_SECRET_KEY=
